# Database Configuration
# Point this to your local postgres container or AWS RDS instance
DATABASE_URL="postgresql://postgres:password123@127.0.0.1:5433/shopstack?schema=public"

# Authentication
# Provide a strong random string for production
JWT_SECRET="supersecretjwtkey123"

# Server Port
PORT=5000

# CORS Configuration
# In production, this MUST exactly match the URL where the frontend is hosted
FRONTEND_URL="http://localhost:3000"
